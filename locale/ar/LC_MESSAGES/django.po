#~ msgid ""
#~ "Since the establishment of the Quality Perfection Center in 2008, our "
#~ "name has become synonymous with quality and trust in the world of "
#~ "comprehensive car maintenance. We started with an ambitious vision to "
#~ "provide services that exceed customer expectations, and we succeeded in "
#~ "building a wide base of individual customers, companies, and government "
#~ "institutions. During more than fifteen years of continuous work, we have "
#~ "proven that success is only determined by commitment, perfection, and "
#~ "constant keenness for development."
#~ msgstr ""
#~ "منذ تأســـيس مركـــز جودة الإتقان عـــام 2008م فـــي، أصبح اســـمنا مرادفً "
#~ "ا للجودة والثقة في عالم صيانة الســـيارات الشـــاملة. انطلقنا برؤية طموحة "
#~ "لتقديم خدمات تتجـــاوز توقعـــات العـــملاء، ونجحنا في بناء قاعدة "
#~ "واســـعة من العـــملاء من الأفراد والشركات والمؤسسات الحكومية. خلال أكثر "
#~ "من خمســـة عشـــة عاما من العمل المتواصل، أثبتنا أن النجاح لا يتحدد الا "
#~ "بالالتزام، الإتقان، والحرص الدائم على التطوير."

#~ msgid ""
#~ "We use the latest electronic inspection systems and intelligent analysis "
#~ "tools to provide an accurate and rapid diagnosis of technical problems. "
#~ "We also provide an online appointment booking service and a car status "
#~ "follow-up service, which facilitates the customer experience and saves "
#~ "time and effort"
#~ msgstr ""
#~ "نســـتخدم أحدث أنظمة الفحص الإلكتروني وأدوات التحليل الذكي لتقديم "
#~ "تشـــخيص دقيق وســـريع للمشـــاكل فنية. كما نوفر خدمة حجز المواعيد "
#~ "ومتابعة حالة السيارة عبر الإنترنت، مما يسهل تجربة العميل ويوفر الوقت "
#~ "والجهد"

#~ msgid ""
#~ "We at Quality Perfection Center are committed to applying environmental "
#~ "safety standards by using environmentally friendly materials and managing "
#~ "waste in safe ways. We also participate in community initiatives to "
#~ "support awareness of traffic safety and the preservation of vehicles"
#~ msgstr ""
#~ "نلتـــزم فـــي مركز جودة الإتقان بتطبيق معاييـــر السلامة البيئية من خلال "
#~ "اســـتخدام مـــواد صديقة للبيئـــة وإدارة النفايات بطرق آمنة. كما "
#~ "نشـــارك في مبادرات مجتمعيـــــة لدعـــــم التوعيــــة بالسلامــــة "
#~ "المروريــــة والحفــاظ علــــى المركبــــات"

#~ msgid "Future Vision & Expansion"
#~ msgstr "الرؤية المستقبلية والتوسع"

#~ msgid ""
#~ "We plan to open new branches inside and outside the city of Riyadh, with "
#~ "the introduction of smart electronic services that support the customer "
#~ "experience and keep pace with technical development"
#~ msgstr ""
#~ "نخطط لافتتاح فروع جديدة داخل وخارج مدينة الرياض، م إدخـــال خدمات "
#~ "إلكترونيـــة ذكية تدعم تجربة العميل وتواكب التطور التقني"

#~ msgid ""
#~ "Because our service does not end with delivery, we care about the "
#~ "smallest details through follow-up and periodic maintenance services and "
#~ "a specialized team to respond to inquiries and provide technical advice "
#~ "around the clock"
#~ msgstr ""
#~ "لأن خدمتنا لاتنتهي عند التسليم، نهتم بأدق التفاصيل من خلال خدمات المتابعة "
#~ "والصيانة الدورية وفريق متخصص للرد على الاستفسارات وتقديم المشورة الفنية "
#~ "على مدار الساعة"

#~ msgid ""
#~ "Comprehensive maintenance including engine systems, automatic "
#~ "transmission, air conditioning, and suspension systems"
#~ msgstr ""
#~ "صيانـــــــة شاملـــــة تشمــــــل أنظمــــــة المحـــــــرك، "
#~ "الفرامــــلالعــــــــــــــــــــــزم، التكييــــــــــــــــــــــف، "
#~ "ونظـــــــــــــــــــم التعليــــــــــــــــــــــق"

